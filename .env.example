# Copy this file to .env at the repository root (the .env file is git-ignored).
# Spring Boot loads it automatically from the root or backend/ folder.
# For the optional Docker MySQL service (docker compose up -d mysql):
# - Port 3307 avoids conflicts with any installed MySQL on 3306.
# - Choose your own strong, non-empty DB_PASSWORD below before starting Docker.
# - Do not use MySQL root for application access.
# For an EXISTING local MySQL instead: use port 3306 and the username/password
# of a MySQL account that has privileges on the gulf_racing database.
# Environment variables in your shell or IntelliJ override values in .env.
DB_URL=jdbc:mysql://127.0.0.1:3307/gulf_racing
DB_USERNAME=medhmar
DB_PASSWORD=
FRONTEND_ORIGINS=http://localhost:5500
OAUTH_SUCCESS_URL=http://localhost:5500/
OAUTH_FAILURE_URL=http://localhost:5500/signin
SESSION_COOKIE_SECURE=false
# For HTTPS production: include prod in SPRING_PROFILES_ACTIVE and set this to true.
# prod enforces secure session cookies even if this local value is left false.

SPRING_PROFILES_ACTIVE=google

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
PASSWORD_RESET_URL=http://localhost:5500/reset-password.html

# Optional assistant: add ai to SPRING_PROFILES_ACTIVE (e.g. ai,google,mail).
# Set the real key in your terminal or IntelliJ environment, not this file.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=600
AI_REQUESTS_PER_MINUTE=10
AI_MAX_CONCURRENT_REQUESTS=4
