# Configure these as environment variables in your terminal or IDE.
# Spring Boot does not automatically load a .env file.
DB_URL=jdbc:mysql://localhost:3306/gulf_racing
DB_USERNAME=
DB_PASSWORD=
FRONTEND_ORIGINS=http://localhost:5500
OAUTH_SUCCESS_URL=http://localhost:5500/
SESSION_COOKIE_SECURE=false

# Optional: enable profiles with SPRING_PROFILES_ACTIVE=google,mail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
PASSWORD_RESET_URL=http://localhost:5500/reset-password.html

# Optional assistant: add ai to SPRING_PROFILES_ACTIVE (e.g. ai,google,mail).
# Set the real key in your terminal or IntelliJ environment, not this file.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=600
AI_REQUESTS_PER_MINUTE=10
AI_MAX_CONCURRENT_REQUESTS=4
